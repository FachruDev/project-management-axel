APP_NAME="Project Management"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://projects.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_AUTO_MIGRATE=true
APP_AUTO_SEED=false
APP_WAIT_FOR_DB=true

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=your-production-postgres-host
DB_PORT=5432
DB_DATABASE=your-production-database
DB_USERNAME=your-production-username
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

PORTAL_SSO_SHARED_KEY=
PORTAL_SSO_DEFAULT_EMAIL_DOMAIN=galenium.com
PORTAL_SSO_EXPIRES_IN_SECONDS=300
PORTAL_SSO_CLOCK_SKEW_SECONDS=5
PORTAL_AUTH_PERSIST_SESSION=true

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=your-smtp-host
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

REVERB_APP_ID=production
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=projects.example.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

LARAVEL_PDF_DRIVER=dompdf

TRUSTED_PROXIES=*

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
